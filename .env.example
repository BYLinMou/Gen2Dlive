# Optional API key. If set (in env/.env.local/.env), /animate and /animate-json require auth.
# Use either:
# - Authorization: Bearer <GEN2DLIVE_API_KEY>
# - X-API-Key: <GEN2DLIVE_API_KEY>
GEN2DLIVE_API_KEY=

# Default particles count when request does not specify `particles`.
# Set to 0 to disable by default.
GEN2DLIVE_DEFAULT_PARTICLES=0

# Defaults used when the request does not provide these fields.
# `GEN2DLIVE_DEFAULT_CYCLE_SEC` is preferred; `GEN2DLIVE_DEFAULT_DURATION_SEC` is kept as a legacy alias.
GEN2DLIVE_DEFAULT_CYCLE_SEC=3.0
GEN2DLIVE_DEFAULT_DURATION_SEC=3.0
GEN2DLIVE_DEFAULT_FPS=30
GEN2DLIVE_DEFAULT_STRENGTH=2.0

# Internal motion sampling fps. Frames will be duplicated to hit output fps.
GEN2DLIVE_MOTION_FPS=10

# Foreground segmentation backend. `rembg` uses an ONNX foreground parser when installed.
GEN2DLIVE_SEGMENTATION_BACKEND=rembg

# Default rembg model. `isnet-anime` is the best default for anime / illustration pipelines.
# Other supported values: `u2net_human_seg`, `u2net`
GEN2DLIVE_SEGMENTATION_MODEL=isnet-anime
